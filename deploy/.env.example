# Copiar a deploy/.env. Todo lo demás se configura desde el panel (Ajustes).
QA_DATABASE_URL=postgres://postgres:change-me@postgres:5432/qa_control_center?sslmode=disable

# Debe coincidir con la contraseña incluida en QA_DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Sigue aquí hasta que el setup pueda detectarla.
QA_PUBLIC_URL=http://localhost:8080

# Generar con: openssl rand -base64 32 (32 bytes). Solo las usan la app y el
# worker; cifran los secretos que viven en la base, por eso no pueden estar en ella.
QA_MASTER_KEY=
QA_WORKER_KEY=
