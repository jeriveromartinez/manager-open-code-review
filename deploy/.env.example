# Copiar a deploy/.env y rellenar los valores vacíos antes de levantar el stack.

# Cadena de conexión usada por app y worker. "postgres" es el nombre del
# servicio en docker compose; sustituye change-me por tu POSTGRES_PASSWORD.
QA_DATABASE_URL=postgres://postgres:change-me@postgres:5432/qa_control_center?sslmode=disable

# URL pública de la app, sin "/" final. En modo solo polling puede ser
# http://localhost:8080 aunque no exista entrada pública.
QA_PUBLIC_URL=http://localhost:8080

# Generar con: openssl rand -base64 32   (debe decodificar a 32 bytes)
# Solo lo usa la app: cifra la configuración de la GitHub App.
# Sólo la app recibe esta clave; NUNCA se pasa al worker.
QA_MASTER_KEY=

# Generar con otra ejecución de: openssl rand -base64 32   (32 bytes)
# La comparten app y worker: cifra API keys de perfiles y tokens de clonado.
# Nunca sustituir por QA_MASTER_KEY.
QA_WORKER_KEY=

# true = recibir webhooks de GitHub; false = modo solo polling.
QA_WEBHOOKS_ENABLED=true

# Frecuencia de reconciliación (duration de Go).
QA_RECONCILE_INTERVAL=5m

# Debe coincidir con la contraseña incluida en QA_DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Backups: cuántos conservar en el volumen backups-data (perfil "backup").
QA_BACKUP_RETENTION=7

# Alertas (perfil "monitor", `qa monitor`). El monitor solo habla HTTP con el
# worker: no necesita base de datos ni claves.
QA_WORKER_HEALTH_URL=http://worker:9090
QA_MONITOR_INTERVAL=1m
QA_MONITOR_RENOTIFY_AFTER=30m
# Vacío = solo log. Con URL, POST JSON genérico por alerta.
QA_ALERT_WEBHOOK_URL=
